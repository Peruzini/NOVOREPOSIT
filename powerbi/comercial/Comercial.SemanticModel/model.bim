            "name": "LucroBrutoCentavos",
            "dataType": "int64",
            "sourceColumn": "LucroBrutoCentavos",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FatoVendas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(",
                "        Web.Contents(\"https://raw.githubusercontent.com\",",
                "            [RelativePath=\"Peruzini/NOVOREPOSIT/a0b11aefd23d71c05243a04217890980a41d47e0/projetos/analise-comercial/dados/tratados/FatoVendas.csv\"]),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Nulos = Table.ReplaceValue(Cabecalho, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalho)),",
                "    Tipos = Table.TransformColumnTypes(Nulos, {{\"VendaID\", type text}, {\"Data\", type date}, {\"LojaID\", type text}, {\"ProdutoID\", type text}, {\"VendedorID\", type text}, {\"Quantidade\", Int64.Type}, {\"PrecoUnitarioCentavos\", Int64.Type}, {\"CustoUnitarioCentavos\", Int64.Type}, {\"DescontoPct\", Int64.Type}, {\"Status\", type text}, {\"ReceitaBrutaCentavos\", Int64.Type}, {\"DescontoCentavos\", Int64.Type}, {\"ReceitaLiquidaCentavos\", Int64.Type}, {\"CustoCentavos\", Int64.Type}, {\"LucroBrutoCentavos\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Receita Bruta",
            "expression": [
              "DIVIDE(SUM(FatoVendas[ReceitaBrutaCentavos]), 100)"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Vendas válidas e concluídas antes dos descontos. Centavos convertidos em reais."
          },
          {
            "name": "Descontos",
            "expression": [
              "DIVIDE(SUM(FatoVendas[DescontoCentavos]), 100)"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Desconto calculado e arredondado por linha, em reais."
          },
          {
            "name": "Receita Liquida",
            "expression": [
              "DIVIDE(SUM(FatoVendas[ReceitaLiquidaCentavos]), 100)"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Receita bruta menos descontos. Não inclui impostos, frete ou devoluções."
          },
          {
            "name": "Custo",
            "expression": [
              "DIVIDE(SUM(FatoVendas[CustoCentavos]), 100)"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Quantidade vendida multiplicada pelo custo unitário, em reais."
          },
          {
            "name": "Lucro Bruto",
            "expression": [
              "DIVIDE(SUM(FatoVendas[LucroBrutoCentavos]), 100)"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Receita líquida menos custo da mercadoria; não é lucro líquido."
          },
          {
            "name": "Margem Bruta",
            "expression": [
              "DIVIDE([Lucro Bruto], [Receita Liquida])"
            ],
            "formatString": "0.00%",
            "description": "Lucro bruto total dividido pela receita líquida total, com ponderação pelo faturamento."
          },
          {
            "name": "Pedidos",
            "expression": [
              "DISTINCTCOUNT(FatoVendas[VendaID])"
            ],
            "formatString": "#,0",
            "description": "Contagem distinta de VendaID. Neste exemplo cada pedido tem um único item."
          },
          {
            "name": "Unidades Vendidas",
            "expression": [
              "SUM(FatoVendas[Quantidade])"
            ],
            "formatString": "#,0",
            "description": "Soma das quantidades das vendas válidas."
          },
          {
            "name": "Ticket Medio",
            "expression": [
              "DIVIDE([Receita Liquida], [Pedidos])"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Receita líquida dividida pela quantidade distinta de pedidos."
          },
          {
            "name": "Receita Mes Anterior",
            "expression": [
              "CALCULATE([Receita Liquida], DATEADD(DimCalendario[Data], -1, MONTH))"
            ],
            "formatString": "\"R$\" #,0.00",
            "description": "Receita no conjunto de datas deslocado um mês para trás. Use em análise mensal."
          },
          {
            "name": "Variacao Receita Mensal",
            "expression": [
              "VAR Atual = [Receita Liquida]",
              "VAR Anterior = [Receita Mes Anterior]",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Atual) && NOT ISBLANK(Anterior),",
              "        DIVIDE(Atual - Anterior, Anterior)",
              "    )"
            ],
            "formatString": "0.00%",
            "description": "Variação relativa ao mês anterior; em branco se um dos períodos não tem receita."
          }
        ]
      }
    ],

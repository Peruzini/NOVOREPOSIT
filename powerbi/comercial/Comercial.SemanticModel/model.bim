              ]
            }
          }
        ]
      },
      {
        "name": "FatoVendas",
        "columns": [
          {
            "name": "VendaID",
            "dataType": "string",
            "sourceColumn": "VendaID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "LojaID",
            "dataType": "string",
            "sourceColumn": "LojaID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProdutoID",
            "dataType": "string",
            "sourceColumn": "ProdutoID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "VendedorID",

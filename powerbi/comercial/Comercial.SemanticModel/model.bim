{
  "name": "Comercial",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "DimCalendario",
        "columns": [
          {
            "name": "Data",
            "dataType": "dateTime",
            "sourceColumn": "Data",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "dd/MM/yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "sourceColumn": "Ano",
            "summarizeBy": "none"
          },
          {
            "name": "Mes",
            "dataType": "int64",
            "sourceColumn": "Mes",
            "summarizeBy": "none"
          },
          {
            "name": "AnoMes",
            "dataType": "string",
            "sourceColumn": "AnoMes",
            "summarizeBy": "none"
          },
          {
            "name": "Dia",
            "dataType": "int64",
            "sourceColumn": "Dia",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCalendario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(",
                "        Web.Contents(\"https://raw.githubusercontent.com\",",
                "            [RelativePath=\"Peruzini/NOVOREPOSIT/a0b11aefd23d71c05243a04217890980a41d47e0/projetos/analise-comercial/dados/tratados/DimCalendario.csv\"]),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Nulos = Table.ReplaceValue(Cabecalho, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalho)),",
                "    Tipos = Table.TransformColumnTypes(Nulos, {{\"Data\", type date}, {\"Ano\", Int64.Type}, {\"Mes\", Int64.Type}, {\"AnoMes\", type text}, {\"Dia\", Int64.Type}}, \"en-US\"),",
                "    Inicio = Date.StartOfYear(List.Min(Tipos[Data])),",
                "    Fim = Date.EndOfYear(List.Max(Tipos[Data])),",
                "    Datas = Table.FromList(List.Dates(Inicio, Duration.Days(Fim - Inicio) + 1, #duration(1, 0, 0, 0)), Splitter.SplitByNothing(), {\"Data\"}),",
                "    DataTipada = Table.TransformColumnTypes(Datas, {{\"Data\", type date}}),",
                "    Ano = Table.AddColumn(DataTipada, \"Ano\", each Date.Year([Data]), Int64.Type),",
                "    Mes = Table.AddColumn(Ano, \"Mes\", each Date.Month([Data]), Int64.Type),",
                "    AnoMes = Table.AddColumn(Mes, \"AnoMes\", each Date.ToText([Data], \"yyyy-MM\", \"en-US\"), type text),",
                "    Completo = Table.AddColumn(AnoMes, \"Dia\", each Date.Day([Data]), Int64.Type)",
                "in",
                "    Completo"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimLoja",

            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(",
                "        Web.Contents(\"https://raw.githubusercontent.com\",",
                "            [RelativePath=\"Peruzini/NOVOREPOSIT/a0b11aefd23d71c05243a04217890980a41d47e0/projetos/analise-comercial/dados/tratados/DimLoja.csv\"]),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Nulos = Table.ReplaceValue(Cabecalho, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalho)),",
                "    Tipos = Table.TransformColumnTypes(Nulos, {{\"LojaID\", type text}, {\"Loja\", type text}, {\"UF\", type text}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "DimProduto",

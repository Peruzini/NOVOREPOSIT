// Estas medidas já estão incluídas no projeto Projetos.pbip.
// Para montar outro relatório manualmente, crie cada medida separadamente.
// DimCalendario[Data] -> FatoDemandas[DataCriacao]: relacionamento ativo.
// DimCalendario[Data] -> FatoDemandas[DataConclusao]: relacionamento inativo.

Demandas = DISTINCTCOUNT(FatoDemandas[DemandaID])

Concluidas = CALCULATE([Demandas], KEEPFILTERS(FatoDemandas[Status] = "Concluida"))

Backlog Aberto = CALCULATE([Demandas], KEEPFILTERS(FatoDemandas[Status] <> "Concluida"))

Em Andamento = CALCULATE([Demandas], KEEPFILTERS(FatoDemandas[Status] = "Em andamento"))

Abertas em Atraso = SUM(FatoDemandas[EmAtraso])

Entregas no Prazo = SUM(FatoDemandas[EntregueNoPrazo])

Taxa de Entregas no Prazo = DIVIDE([Entregas no Prazo], [Concluidas])

Tempo Medio de Ciclo = AVERAGE(FatoDemandas[TempoCicloDias])

Lead Time Medio = AVERAGE(FatoDemandas[LeadTimeDias])

Data de Referencia = MAX(FatoDemandas[DataReferencia])

Concluidas por Data de Entrega =
CALCULATE([Concluidas], USERELATIONSHIP(DimCalendario[Data], FatoDemandas[DataConclusao]))

Percentual do Backlog em Atraso = DIVIDE([Abertas em Atraso], [Backlog Aberto])

No Prazo por Data de Entrega =
CALCULATE([Entregas no Prazo], USERELATIONSHIP(DimCalendario[Data], FatoDemandas[DataConclusao]))

Taxa no Prazo por Data de Entrega =
DIVIDE([No Prazo por Data de Entrega], [Concluidas por Data de Entrega])

Ciclo por Data de Entrega =
CALCULATE([Tempo Medio de Ciclo], USERELATIONSHIP(DimCalendario[Data], FatoDemandas[DataConclusao]))
